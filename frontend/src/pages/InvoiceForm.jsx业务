import React, { useState, useEffect, useCallback } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { invoiceApi, clientApi, settingsApi } from '../services/api';
import { formatCurrency as baseFormat, getFinancialYear, numberToWords } from '../utils/helpers';
import { toast } from 'react-toastify';
import {
  Plus, Trash2, Save, Send, Upload, X, User, Landmark, 
  Search, Edit3, Truck, Building2, Calendar, Hash, 
  PlusCircle, CheckCircle, AlignLeft, AlignCenter, AlignRight,
  ChevronDown, LayoutGrid, FileText, Info, Percent,
  Image as ImageIcon, PenTool, Globe, Clock, Tag, ChevronRight,
  PlusSquare, ImagePlus, Settings2, DollarSign, Languages, ListFilter,
  Copy, Scale, Zap, Gem, CheckSquare, Square, Eye, Monitor, ShieldCheck,
  EyeOff, GripVertical, Pen, Paperclip, Phone
} from 'lucide-react';

const COUNTRIES = [
  { name: 'India', currency: 'INR', symbol: '₹', format: 'en-IN', system: 'Lakhs' },
  { name: 'United States', currency: 'USD', symbol: '$', format: 'en-US', system: 'Millions' },
];

const COLUMNS = [
  { id: 'name', label: 'Item', visible: true },
  { id: 'hsn', label: 'HSN/SAC', visible: true },
  { id: 'gstRate', label: 'GST Rate', visible: true },
  { id: 'quantity', label: 'Quantity', visible: true },
  { id: 'rate', label: 'Rate', visible: true },
  { id: 'amount', label: 'Amount', visible: true },
];

const defaultItem = (gstRate = 18) => ({ 
  id: Date.now() + Math.random(), 
  name: '', hsn: '', gstRate: gstRate, quantity: 1, rate: 0, 
  amount: 0, cgst: 0, sgst: 0, total: 0, 
  description: '', image: '', unit: 'Product', expanded: false
});

const InvoiceForm = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [loading, setLoading] = useState(true);
  const [clients, setClients] = useState([]);
  const [showTaxModal, setShowTaxModal] = useState(false);
  const [showFormatModal, setShowFormatModal] = useState(false);
  const [showColumnsModal, setShowColumnsModal] = useState(false);

  const [form, setForm] = useState({
    header: {
      title: 'Invoice', subtitle: '', invoiceNumber: 'INV-00001',
      invoiceDate: new Date().toISOString().slice(0, 10), dueDate: '', logo: '', showSubtitle: false
    },
    business: { name: 'Software Developer', gstin: '', address: 'India', state: 'Other Territory' },
    client: { id: '', name: '', gstin: '', address: '', state: '' },
    items: [defaultItem()],
    totals: { 
      discount: 0, discountType: 'percentage', additionalCharges: 0, 
      roundOffEnabled: true, notes: '', terms: '',
      showTotalInPdf: true, summariseQty: false, showWords: true
    },
    settings: {
      gstEnabled: true, currency: 'INR', currencySymbol: '₹', numberFormat: 'en-IN',
      decimalDigits: 2, taxType: 'CGST & SGST', placeOfSupply: 'Other Territory',
      isRecurring: false
    },
    columns: COLUMNS
  });

  const format = (amt) => Number(amt || 0).toLocaleString(form.settings.numberFormat, { 
    style: 'currency', currency: form.settings.currency, minimumFractionDigits: form.settings.decimalDigits
  });

  useEffect(() => {
    const init = async () => {
      try {
        const [sRes, cRes] = await Promise.all([settingsApi.get(), clientApi.getAll()]);
        setClients(cRes.data);
        if (!id) {
          const s = sRes.data;
          setForm(f => ({
            ...f,
            business: { name: s.businessName || 'Software Developer', gstin: s.gstin, address: s.address || 'India', state: s.state || 'Other Territory' },
            header: { ...f.header, invoiceNumber: `${s.invoicePrefix || 'INV'}-${String(s.invoiceCounter || 1).padStart(5, '0')}` }
          }));
        } else {
          const { data } = await invoiceApi.getById(id);
          setForm(data);
        }
      } catch { toast.error('Error init builder'); }
      finally { setLoading(false); }
    };
    init();
  }, [id]);

  const calculate = useCallback(() => {
    let subtotal = 0, totalCgst = 0, totalSgst = 0, totalIgst = 0, totalQty = 0;
    const items = form.items.map(it => {
      const amount = it.quantity * it.rate;
      const taxTotal = form.settings.gstEnabled ? (amount * it.gstRate) / 100 : 0;
      let cgst = 0, sgst = 0, igst = 0;
      if (form.settings.taxType === 'CGST & SGST') { cgst = taxTotal / 2; sgst = taxTotal / 2; }
      else { igst = taxTotal; }
      subtotal += amount; totalCgst += cgst; totalSgst += sgst; totalIgst += igst; totalQty += Number(it.quantity);
      return { ...it, amount, cgst, sgst, igst, total: amount + taxTotal };
    });
    const disc = form.totals.discountType === 'percentage' ? (subtotal * form.totals.discount) / 100 : Number(form.totals.discount);
    const preRound = subtotal + totalCgst + totalSgst + totalIgst - disc + Number(form.totals.additionalCharges);
    const grandTotal = Math.round(preRound);
    return { subtotal, taxAmt: totalCgst + totalSgst + totalIgst, cgst: totalCgst, sgst: totalSgst, igst: totalIgst, grandTotal, items, totalQty, totalInWords: numberToWords(grandTotal) };
  }, [form.items, form.totals, form.settings]);

  const live = calculate();

  const updateItem = (id, k, v) => setForm(f => ({ ...f, items: f.items.map(x => x.id === id ? { ...x, [k]: v } : x) }));

  if (loading) return <div className="min-h-screen flex items-center justify-center bg-slate-50"><div className="w-12 h-12 border-4 border-purple-600 border-t-transparent rounded-full animate-spin"/></div>;

  return (
    <div className="flex min-h-screen bg-[#F8F9FD]">
      <div className="flex-1 p-10 overflow-y-auto max-h-screen custom-scrollbar">
        <div className="max-w-6xl mx-auto space-y-10 animate-fade-in pb-20">
          
          {/* HEADER SECTION */}
          <div className="bg-white rounded-[2.5rem] p-12 shadow-sm border border-slate-100">
            <div className="text-center mb-12">
              <input className="text-4xl font-black text-slate-800 bg-transparent border-none text-center focus:ring-0 p-0" value={form.header.title} onChange={e=>setForm({...form, header:{...form.header, title:e.target.value}})}/>
              <button className="text-sm font-bold text-purple-600 mt-2 block mx-auto hover:underline">+ Add Subtitle</button>
            </div>
            <div className="flex justify-between items-start">
              <div className="space-y-6 w-96">
                <div className="flex items-center gap-10"><label className="text-sm font-bold text-slate-500 w-32">Invoice No*</label><input className="text-sm font-black text-slate-800 border-b border-slate-100 outline-none pb-1 w-full" value={form.header.invoiceNumber}/></div>
                <div className="flex items-center gap-10"><label className="text-sm font-bold text-slate-500 w-32">Invoice Date*</label><div className="flex items-center justify-between w-full border-b border-slate-100 pb-1"><input type="date" className="text-sm font-black text-slate-800 bg-transparent border-none p-0 outline-none w-full" value={form.header.invoiceDate} onChange={e=>setForm({...form, header:{...form.header, invoiceDate:e.target.value}})}/></div></div>
                <div className="flex items-center gap-10"><label className="text-sm font-bold text-slate-500 w-32">Due Date</label><div className="flex items-center justify-between w-full border-b border-slate-100 pb-1"><input type="date" className="text-sm font-black text-slate-800 bg-transparent border-none p-0 outline-none w-full" value={form.header.dueDate} onChange={e=>setForm({...form, header:{...form.header, dueDate:e.target.value}})}/></div></div>
              </div>
              <div className="w-64 h-40 bg-[#FDFDFD] border-2 border-dashed border-slate-100 rounded-2xl flex flex-col items-center justify-center text-slate-300">
                <ImageIcon size={32} className="text-slate-200 mb-3"/><span className="text-sm font-black text-slate-400">Add Business Logo</span>
              </div>
            </div>
          </div>

          {/* IDENTITY SECTION */}
          <div className="grid grid-cols-2 gap-8">
            <div className="bg-white rounded-[2.5rem] p-10 shadow-sm border border-slate-100">
              <div className="flex items-center gap-2 mb-8"><h3 className="text-xl font-black text-slate-800">Billed By</h3><span className="text-xs font-bold text-slate-400 mt-1">Your Details</span></div>
              <div className="bg-[#F8F9FD] rounded-2xl p-6 border border-slate-50">
                <div className="flex items-center gap-4 mb-6"><div className="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-white font-black text-xs">S</div><div className="flex-1 flex justify-between items-center"><span className="text-sm font-black text-slate-800">{form.business.name}</span><ChevronDown size={18} className="text-slate-300"/></div></div>
                <div className="space-y-1"><p className="text-[10px] font-black uppercase text-slate-300 tracking-widest">Address</p><p className="text-sm font-black text-slate-700">{form.business.address}</p></div>
              </div>
            </div>
            <div className="bg-white rounded-[2.5rem] p-10 shadow-sm border border-slate-100">
              <div className="flex items-center gap-2 mb-8"><h3 className="text-xl font-black text-slate-800">Billed To</h3><span className="text-xs font-bold text-slate-400 mt-1">Client's Details</span></div>
              <div className="bg-[#F8F9FD] rounded-2xl p-6 border border-slate-50 min-h-[160px] flex flex-col items-center justify-center text-center">
                <select className="w-full bg-white border border-slate-100 rounded-xl px-4 py-3 text-sm font-black text-slate-400 outline-none mb-6" value={form.client.id} onChange={e=>{const c=clients.find(x=>x._id===e.target.value); if(c) setForm(f=>({...f, client:{id:c._id, name:c.name, gstin:c.gstin, address:c.billingAddress?.city, state:c.billingAddress?.state}}))}}><option value="">Select a Client</option>{clients.map(c=><option key={c._id} value={c._id}>{c.name}</option>)}</select>
                <button className="bg-purple-600 text-white font-black text-sm px-8 py-3 rounded-xl shadow-lg shadow-purple-100">+ Add New Client</button>
              </div>
            </div>
          </div>

          {/* COMMAND BAR */}
          <div className="flex items-center gap-4">
            <button onClick={()=>setShowTaxModal(true)} className="btn-config"><Percent size={18} className="text-purple-600"/> Configure GST</button>
            <div className="flex-1 max-w-[280px]"><p className="text-[10px] font-black uppercase text-slate-400 mb-1 ml-1">Currency*</p><div className="relative"><select className="w-full bg-white border border-slate-200 rounded-lg pl-4 pr-10 py-3 text-sm font-bold text-slate-700 outline-none" value={form.settings.currency} onChange={e=>{const c=COUNTRIES.find(x=>x.currency===e.target.value); if(c) setForm({...form, settings:{...form.settings, currency:c.currency, currencySymbol:c.symbol, numberFormat:c.format}})}}>{COUNTRIES.map(c=><option key={c.currency} value={c.currency}>{c.name} ({c.currency}, {c.symbol})</option>)}</select><ChevronDown size={18} className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none"/></div></div>
            <button onClick={()=>setShowFormatModal(true)} className="btn-config"><span className="text-purple-600 font-black">123</span> Format</button>
            <button onClick={()=>setShowColumnsModal(true)} className="btn-config"><LayoutGrid size={18} className="text-purple-600"/> Edit Columns</button>
          </div>

          {/* ITEMS TABLE */}
          <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <table className="w-full text-left">
              <thead>
                <tr className="bg-[#7C3AED] text-white text-[11px] font-black uppercase tracking-widest">
                  <th className="p-4 pl-6">Item</th>
                  {form.columns.find(c=>c.id==='hsn')?.visible && <th className="p-4 w-28 text-center">HSN/SAC</th>}
                  {form.columns.find(c=>c.id==='gstRate')?.visible && <th className="p-4 w-20 text-center">GST Rate</th>}
                  {form.columns.find(c=>c.id==='quantity')?.visible && <th className="p-4 w-20 text-center">Quantity</th>}
                  {form.columns.find(c=>c.id==='rate')?.visible && <th className="p-4 w-28 text-center">Rate</th>}
                  {form.columns.find(c=>c.id==='amount')?.visible && <th className="p-4 w-28 text-right">Amount</th>}
                  <th className="p-4 w-32 pr-6 text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                {form.items.map((it, idx) => (
                  <tr key={it.id} className="group border-b border-slate-50"><td className="p-6 pl-10 relative"><div className="absolute left-4 top-6 text-sm font-black text-slate-800">{idx+1}.</div><input className="item-input" value={it.name} onChange={e=>updateItem(it.id, 'name', e.target.value)}/><div className="flex gap-4 mt-2"><button className="text-[10px] font-black text-purple-600 uppercase">+ Description</button><button className="text-[10px] font-black text-purple-600 uppercase">+ Image</button></div></td>{form.columns.find(c=>c.id==='hsn')?.visible && <td className="p-4"><input className="item-input text-center" value={it.hsn} onChange={e=>updateItem(it.id, 'hsn', e.target.value)}/></td>}{form.columns.find(c=>c.id==='gstRate')?.visible && <td className="p-4"><input className="item-input text-center" value={it.gstRate} onChange={e=>updateItem(it.id, 'gstRate', Number(e.target.value))}/></td>}{form.columns.find(c=>c.id==='quantity')?.visible && <td className="p-4"><input className="item-input text-center" value={it.quantity} onChange={e=>updateItem(it.id, 'quantity', e.target.value)}/></td>}{form.columns.find(c=>c.id==='rate')?.visible && <td className="p-4"><input className="item-input text-center" value={it.rate} onChange={e=>updateItem(it.id, 'rate', e.target.value)}/></td>}{form.columns.find(c=>c.id==='amount')?.visible && <td className="p-4 text-right font-bold text-slate-700">{format(it.amount)}</td>}<td className="p-4 pr-6 text-right font-black text-slate-900">{format(it.total)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* TOTALS & SIGNATURE */}
          <div className="flex flex-col items-end space-y-10">
            <div className="bg-white rounded-3xl p-10 shadow-sm border border-slate-100 w-full max-w-lg space-y-6">
              <div className="flex justify-between items-center mb-6"><h3 className="text-sm font-black text-slate-800 uppercase tracking-widest">Show Total in PDF</h3><Eye size={18} className="text-slate-300"/></div>
              <div className="space-y-3">
                <div className="flex justify-between text-sm font-bold text-slate-500"><span>Amount</span><span>{format(live.subtotal)}</span></div>
                <div className="flex justify-between text-sm font-bold text-slate-500"><span>SGST</span><span>{format(live.sgst)}</span></div>
                <div className="flex justify-between text-sm font-bold text-slate-500"><span>CGST</span><span>{format(live.cgst)}</span></div>
              </div>
              <div className="pt-10 flex justify-between items-center"><span className="text-xl font-black text-slate-800 uppercase">Total ({form.settings.currency})</span><span className="text-3xl font-black text-slate-900 tracking-tighter">{format(live.grandTotal)}</span></div>
            </div>
            <div className="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 w-full max-w-lg relative">
              <div className="flex justify-between items-center mb-4"><h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest">Show Total In Words</h3><EyeOff size={16} className="text-slate-300"/></div>
              <p className="text-xs font-black text-slate-500 underline decoration-slate-200 underline-offset-4">{live.totalInWords}</p>
            </div>
            <button className="w-full max-w-lg bg-white border-2 border-dashed border-slate-100 rounded-2xl py-6 text-sm font-black text-slate-400 hover:border-purple-200 transition-all flex items-center justify-center gap-3">
              <Pen size={18} className="text-slate-200"/> Add Signature
            </button>
          </div>

          {/* NEW ENTERPRISE FOOTER GRID (MODULAR ACTIONS) */}
          <div className="grid grid-cols-3 gap-6">
            <button className="flex items-center gap-3 p-5 bg-white border-2 border-dashed border-slate-100 rounded-2xl text-xs font-black text-slate-500 hover:border-purple-200 transition-all">
              <div className="w-6 h-6 rounded-md bg-purple-50 flex items-center justify-center text-purple-600"><Plus size={14}/></div>
              Add Terms & Conditions
            </button>
            <button className="flex items-center gap-3 p-5 bg-white border-2 border-dashed border-slate-100 rounded-2xl text-xs font-black text-slate-500 hover:border-purple-200 transition-all">
              <div className="w-6 h-6 rounded-md bg-purple-50 flex items-center justify-center text-purple-600"><FileText size={14}/></div>
              Add Notes
            </button>
            <button className="flex items-center gap-3 p-5 bg-white border-2 border-dashed border-slate-100 rounded-2xl text-xs font-black text-slate-500 hover:border-purple-200 transition-all">
              <div className="w-6 h-6 rounded-md bg-purple-50 flex items-center justify-center text-purple-600"><Paperclip size={14}/></div>
              Add Attachments
            </button>
            <button className="flex items-center gap-3 p-5 bg-white border-2 border-dashed border-slate-100 rounded-2xl text-xs font-black text-slate-500 hover:border-purple-200 transition-all">
              <div className="w-6 h-6 rounded-md bg-purple-50 flex items-center justify-center text-purple-600"><Info size={14}/></div>
              Add Additional Info
            </button>
            <button className="flex items-center gap-3 p-5 bg-white border-2 border-dashed border-slate-100 rounded-2xl text-xs font-black text-slate-500 hover:border-purple-200 transition-all">
              <div className="w-6 h-6 rounded-md bg-purple-50 flex items-center justify-center text-purple-600"><Phone size={14}/></div>
              Add Contact Details
            </button>
          </div>

          {/* RECURRING INVOICE AUTOMATION CARD */}
          <div className="bg-white rounded-[2.5rem] p-10 border-2 border-slate-50 shadow-sm">
            <div className="flex items-start gap-6">
              <div 
                onClick={()=>setForm({...form, settings:{...form.settings, isRecurring: !form.settings.isRecurring}})}
                className={`w-14 h-8 rounded-full p-1 cursor-pointer transition-all duration-300 ${form.settings.isRecurring ? 'bg-purple-600' : 'bg-slate-200'}`}
              >
                <div className={`w-6 h-6 bg-white rounded-full shadow-lg transform transition-transform duration-300 ${form.settings.isRecurring ? 'translate-x-6' : 'translate-x-0'}`}/>
              </div>
              <div className="space-y-1">
                <h3 className="text-lg font-black text-slate-800">This is a Recurring invoice</h3>
                <p className="text-sm font-bold text-slate-400">A draft invoice will be created with the same details every next period.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

      {/* ACTION CONSOLE */}
      <div className="w-80 bg-white border-l border-slate-100 p-8 flex flex-col gap-6 shadow-2xl z-40">
        <h2 className="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2"><Monitor size={20} className="text-purple-600"/> Console</h2>
        <button className="w-full bg-[#7C3AED] text-white font-black py-4 rounded-2xl shadow-xl shadow-purple-200 hover:scale-[1.02] transition-all flex items-center justify-center gap-3"><Send size={18}/> SAVE & SEND</button>
        <button className="w-full bg-slate-50 text-slate-600 font-black py-4 rounded-2xl hover:bg-slate-100 transition-all flex items-center justify-center gap-3"><Save size={18}/> SAVE DRAFT</button>
      </div>

    </div>
  );
};

export default InvoiceForm;
